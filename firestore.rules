rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Global Safety Net ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      // 1. If signed in, check if UID matches the path
      // 2. OR if it's the special 'admin-master' path
      return (isSignedIn() && request.auth.uid == userId) || userId == 'admin-master';
    }

    // --- User Collections ---
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || userId == 'admin-master';

      match /{collectionName}/{docId} {
        allow read: if true;
        allow write: if isOwner(userId) || userId == 'admin-master';
      }
      
      match /{allPaths=**} {
        allow read: if true;
        allow write: if isOwner(userId) || userId == 'admin-master';
      }
    }
    
    match /test/connection {
      allow read: if true;
    }
  }
}
